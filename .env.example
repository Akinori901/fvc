# Django
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=fair_value_calculator
MYSQL_USER=fvc_user
MYSQL_PASSWORD=fvc_password
MYSQL_HOST=db
MYSQL_PORT=3306

# CORS (本番環境用、カンマ区切り)
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# 静的ファイル (本番環境用)
# STATIC_URL=https://your-s3-bucket.s3.amazonaws.com/static/

# AWS (Terraform / デプロイ用)
# AWS_ACCOUNT_ID=123456789012
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=ap-northeast-1

# Basic認証 (CloudFront)
# BASIC_AUTH_USER=your-username
# BASIC_AUTH_PASS=your-password

# 管理者ロール専用 OpenAI APIキー（任意・開発時のみ）
# - 本番では SSM Parameter Store (SecureString) から取得される（OPENAI_ADMIN_KEY_SSM_PARAMETER 経由）
# - ローカル開発で管理者ロールのチャット動作確認をしたい場合のみ、開発者本人の OpenAI キーを設定
# - 本番キーは絶対にここに書かないこと
# OPENAI_ADMIN_API_KEY=

# Cognito (OAuth 認証 - バックエンド用)
# - 本番では Terraform 経由で Lambda 環境変数に自動注入される
# - ローカル開発で Cognito 認証を試したい場合のみ設定（基本は不要）
# COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
# COGNITO_REGION=ap-northeast-1
# COGNITO_WEB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_GPT_CLIENT_ID=yyyyyyyyyyyyyyyyyyyyyyyyyy
# COGNITO_DOMAIN_PREFIX=fvc-prod

# Cognito (OAuth 認証 - フロントエンド/Vite ビルド用)
# - 本番ではビルド時に CD パイプラインから注入される
# - ローカル開発で Cognito ログインを試したい場合のみ設定
# - VITE_ プレフィックスのものはビルド成果物にバンドルされる (公開情報のみ可)
# VITE_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
# VITE_COGNITO_WEB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_COGNITO_DOMAIN_PREFIX=fvc-prod
# VITE_COGNITO_REGION=ap-northeast-1
